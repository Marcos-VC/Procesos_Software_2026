# better-sqlite3 v13 trae los binarios precompilados dentro del paquete (prebuilds/)
# y declara gypfile:false, pero npm ignora ese campo al instalar desde
# package-lock.json e intenta compilar con node-gyp (exige Python y un compilador).
# Ningún paquete del backend necesita scripts de instalación, así que se desactivan.
ignore-scripts=true
